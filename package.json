{
  "name": "wae-query",
  "version": "0.1.2",
  "description": "Type-safe SQL query builder for WAE datasets.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "wae",
    "cloudflare",
    "workers",
    "workers-analytics-engine",
    "query-builder",
    "sql",
    "typescript",
    "click-house",
    "cloudflare-workers",
    "orm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D4ario0/wae-query.git"
  },
  "bugs": {
    "url": "https://github.com/D4ario0/wae-query/issues"
  },
  "homepage": "https://github.com/D4ario0/wae-query#readme",
  "author": "D4ario0",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
